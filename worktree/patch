+export function moveMarker(arrangement: Arrangement, id: string, time: number): MoveMarkerResult {
+  const markers = arrangementMarkers(arrangement);
+  const current = markers.find((marker) => marker.id === id);
+  if (!current) {
+    return { kind: 'unchanged', arrangement };
+  }
