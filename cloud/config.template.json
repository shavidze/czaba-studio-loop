{
  "projectName": "czaba-studio",
  "repoDir": "__CZ__/store",
  "loopDir": "__CZ__/tmp/studio-real-loop",
  "branch": "master",
  "pushRemotes": ["https://github.com/TCzaba/czaba-store.git", "https://github.com/shavidze/czaba-store.git"],
  "verifyCommand": "npm run verify",
  "servers": [
    {
      "name": "store",
      "healthUrl": "http://127.0.0.1:5173/studio-lab",
      "startFile": "npx",
      "startArgs": ["remix", "vite:dev", "--host", "127.0.0.1", "--port", "5173"],
      "cwd": "__CZ__/store"
    }
  ],
  "protectedPaths": ["app/routes/studio.$productId.tsx", "app/routes/api.studio-token.ts", "app/routes/account.downloads.tsx", "app/lib/__tests__/download-routes.test.ts"],
  "agentsFile": "__CZ__/tmp/studio-real-loop/agents.json",
  "roleAgents": { "planner": "studio-task-writer", "implementer": "studio-implementer", "verifier": "studio-product-verifier", "reviewer": "code-reviewer" },
  "models": { "planner": "", "implementer": "claude-opus-5-5", "verifier": "", "reviewer": "" },
  "consultAgents": {
    "planner": ["tech-lead", "product-manager", "design-philosopher", "flow-sage", "first-visit-host", "consequence-tester"],
    "implementer": ["code-reviewer"],
    "verifier": ["accessibility-auditor", "code-reviewer", "design-auditor", "ableton-arrangement-expert", "studio-specialist", "performance-optimizer"],
    "reviewer": []
  },
  "cleanupProcessPattern": "vitest",
  "commitType": "feat",
  "commitScope": "studio",
  "roundLimit": 1,
  "maxLimitWaitSeconds": 5400,
  "contextRestartTokens": 650000,
  "pushTimeoutSeconds": 1800
}
