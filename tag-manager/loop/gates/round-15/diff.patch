+describe("MetadataPanel save whose write succeeded but whose re-read rejects (TM-B18, D-24)", () => {
+  function expectStoreUnchanged(seedA: WavMetadata, seedB: WavMetadata): void {
+    const stored = useFileStore.getState().metadata;
+    expect(stored[PATH_A]).toEqual(seedA);
+    expect(stored[PATH_B]).toEqual(seedB);
+  }
+
+  function expectNoStaleSkipSync(expectedAfterResync: WavMetadata): void {
+    act(() => {
+      useMetadataStore.getState().setIsDirty(false);
+    });
+    expect(useMetadataStore.getState().editingMetadata).toEqual(expectedAfterResync);
+  }
+
+  async function typeCategoryAndSaveCountingToasts(saveButtonName: RegExp): Promise<number> {
+    const toastKeyBefore = useMetadataStore.getState().toastKey;
+    await typeCategoryAndSave(saveButtonName);
+    return useMetadataStore.getState().toastKey - toastKeyBefore;
+  }
+
+  function expectToast(message: string, toastsShown: number): void {
+    expect(toastsShown).toBe(1);
+    const state = useMetadataStore.getState();
+    expect(state.toastMessage).toBe(message);
+    expect(state.toastType).toBe("error");
+  }
+
