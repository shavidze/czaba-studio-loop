+  it("(u1) takes the write generation before each chunk read and records it only for paths in that chunk's result", async () => {
+    const paths = Array.from({ length: 101 }, (_, index) => `/m/${index}.wav`);
+    let generation = 0;
+    const getWriteGeneration = vi.fn(() => generation);
+    const readBatch = vi.mocked(window.api.readMetadataBatch);
+    readBatch.mockReset();
+    readBatch
+      .mockImplementationOnce(async (chunk) => {
+        generation += 1;
+        return Object.fromEntries(chunk.map((path) => [path, { title: path }]));
+      })
+      .mockRejectedValueOnce(new Error("chunk 2 failed"))
+      .mockImplementationOnce(async (chunk) => Object.fromEntries(chunk.map((path) => [path, { title: path }])));
+
+    try {
+      const result = await readMetadataChunked(paths, [], getWriteGeneration);
+
+      const expectedGenerations: Record<string, number> = {};
+      for (const path of paths.slice(0, 50)) expectedGenerations[path] = 0;
+      expectedGenerations["/m/100.wav"] = 1;
+      expect(result.failures).toBe(50);
+      expect(result.readGenerations).toEqual(expectedGenerations);
+      expect(getWriteGeneration).toHaveBeenCalledTimes(3);
+      expect(readBatch.mock.calls.map((call) => call[0].length)).toEqual([50, 50, 1]);
+      expect(Object.keys(result.data).sort()).toEqual(Object.keys(expectedGenerations).sort());
