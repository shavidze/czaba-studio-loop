@@ -1,6 +1,114 @@
+import { type ElectronApplication, type Page, _electron as electron } from "@playwright/test";
+import type { ChildProcess } from "node:child_process";
+import { existsSync, statSync } from "node:fs";
+import { isAbsolute, join } from "node:path";
+
+export const FIRST_WINDOW_TIMEOUT_MS = 60000;
+export const LAUNCH_HOOK_TIMEOUT_MS = 90000;
+export const ELECTRON_REQUIRE_ENV = "TAG_MANAGER_E2E_ELECTRON_REQUIRE";
+
+const MAIN_OUTPUT_TAIL_CHARS = 4000;
+const FAILED_APP_CLOSE_TIMEOUT_MS = 10000;
+const DOM_CONTENT_LOADED_TIMEOUT_MS = 15000;
+
+export interface LaunchTagManagerOptions {
+  env?: Record<string, string | undefined>;
+}
+
+export interface LaunchedTagManagerApp {
+  app: ElectronApplication;
+  page: Page;
+}
+
+function getElectronRequireArgs(): string[] {
+  const requirePath = process.env[ELECTRON_REQUIRE_ENV];
+  if (requirePath === undefined || requirePath === "") {
+    return [];
+  }
+  if (!isAbsolute(requirePath)) {
+    throw new Error(`${ELECTRON_REQUIRE_ENV} must be an absolute path, got: ${requirePath}`);
+  }
+  if (!existsSync(requirePath) || !statSync(requirePath).isFile()) {
+    throw new Error(`${ELECTRON_REQUIRE_ENV} must point to an existing file, got: ${requirePath}`);
+  }
+  return ["-r", requirePath];
+}
+
 export function getElectronLaunchArgs(mainEntryPath: string): string[] {
+  const requireArgs = getElectronRequireArgs();
   if (process.platform === "linux") {
-    return ["--no-sandbox", mainEntryPath];
+    return ["--no-sandbox", ...requireArgs, mainEntryPath];
+  }
+  return [...requireArgs, mainEntryPath];
+}
+
+function captureMainProcessOutput(mainProcess: ChildProcess): () => string {
+  let output = "";
+  const appendOutput = (chunk: Buffer | string): void => {
+    output = `${output}${chunk.toString()}`.slice(-MAIN_OUTPUT_TAIL_CHARS);
+  };
+  mainProcess.stdout?.on("data", appendOutput);
+  mainProcess.stderr?.on("data", appendOutput);
+  return () => output;
+}
+
+async function closeFailedTagManagerApp(app: ElectronApplication): Promise<void> {
+  const mainProcess = app.process();
+  let closeTimer: NodeJS.Timeout | undefined;
+  const closeTimeout = new Promise<void>((resolve) => {
+    closeTimer = setTimeout(resolve, FAILED_APP_CLOSE_TIMEOUT_MS);
+  });
+  await Promise.race([app.close().catch(() => undefined), closeTimeout]);
+  clearTimeout(closeTimer);
+  if (mainProcess.exitCode === null && mainProcess.signalCode === null) {
+    mainProcess.kill("SIGKILL");
+  }
+}
+
+function describeLaunchFailure(params: {
+  error: unknown;
+  windowAppeared: boolean;
+  elapsedMs: number;
+  mainOutput: string;
+}): string {
+  const { error, windowAppeared, elapsedMs, mainOutput } = params;
+  const errorMessage = error instanceof Error ? error.message : String(error);
+  let reason = `first window failed before ${FIRST_WINDOW_TIMEOUT_MS} ms: ${errorMessage}`;
+  if (windowAppeared) {
+    reason = `first window appeared but domcontentloaded did not finish within ${DOM_CONTENT_LOADED_TIMEOUT_MS} ms: ${errorMessage}`;
+  } else if (error instanceof Error && error.name === "TimeoutError") {
+    reason = `first window did not appear within ${FIRST_WINDOW_TIMEOUT_MS} ms`;
+  }
+  return `${reason} (elapsed ${elapsedMs} ms)\n--- main process output (last ${MAIN_OUTPUT_TAIL_CHARS} chars) ---\n${mainOutput}`;
+}
+
+export async function launchTagManagerApp(
+  options: LaunchTagManagerOptions = {},
+): Promise<LaunchedTagManagerApp> {
+  const launchArgs = getElectronLaunchArgs(join(__dirname, "../../out/main/index.js"));
+  const startedAt = Date.now();
+  let app: ElectronApplication | undefined;
+  let readMainOutput = (): string => "";
+  let windowAppeared = false;
+  try {
+    app = await electron.launch({
+      args: launchArgs,
+      env: { ...process.env, NODE_ENV: "production", ...options.env },
+      timeout: FIRST_WINDOW_TIMEOUT_MS,
+    });
+    readMainOutput = captureMainProcessOutput(app.process());
+    const remainingMs = Math.max(1, FIRST_WINDOW_TIMEOUT_MS - (Date.now() - startedAt));
+    const page = await app.firstWindow({ timeout: remainingMs });
+    windowAppeared = true;
+    await page.waitForLoadState("domcontentloaded", { timeout: DOM_CONTENT_LOADED_TIMEOUT_MS });
+    return { app, page };
+  } catch (error: unknown) {
+    const elapsedMs = Date.now() - startedAt;
+    if (app !== undefined) {
+      await closeFailedTagManagerApp(app);
+    }
+    throw new Error(
+      describeLaunchFailure({ error, windowAppeared, elapsedMs, mainOutput: readMainOutput() }),
+    );
   }
-  return [mainEntryPath];
 }
