+  describe("meta:write keywords via InfoTag IKEY chunk", () => {
+    it("writes keywords into a raw IKEY chunk and reads them back", async () => {
+      const writeHandler = getHandler("meta:write");
+      const readHandler = getHandler("meta:read");
+      const filePath = join(testDir, "roundtrip.wav");
+
+      await writeHandler({}, filePath, { keywords: "door, slam" }, STANDARD_FIELDS);
+
+      const meta = await readHandler({}, filePath, STANDARD_FIELDS) as Record<string, unknown>;
+      expect(meta.keywords).toBe("door, slam");
+
+      const bytes = readFileSync(filePath);
+      const infoOffset = bytes.indexOf(Buffer.from("INFO", "ascii"));
+      expect(infoOffset).toBeGreaterThanOrEqual(8);
+      expect(bytes.toString("ascii", infoOffset - 8, infoOffset - 4)).toBe("LIST");
+      const ikeyOffset = bytes.indexOf(Buffer.from("IKEY", "ascii"), infoOffset + 4);
+      expect(ikeyOffset).toBeGreaterThan(infoOffset);
+      expect(ikeyOffset).toBeLessThan(infoOffset + bytes.readUInt32LE(infoOffset - 4));
+      const chunkSize = bytes.readUInt32LE(ikeyOffset + 4);
+      const expected = Buffer.from("door, slam", "ascii");
+      expect(chunkSize).toBeGreaterThanOrEqual(expected.length);
+      const payload = bytes.subarray(ikeyOffset + 8, ikeyOffset + 8 + chunkSize);
+      expect(payload.subarray(0, expected.length).equals(expected)).toBe(true);
+      expect(payload.subarray(expected.length).every((b) => b === 0)).toBe(true);
+    });
+  });
