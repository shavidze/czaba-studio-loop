+      expect(result.failures).toBe(100);
+      expect(Object.keys(result.data)).toEqual(resolvedPaths);
+      expect(Object.keys(result.readGenerations)).toEqual(resolvedPaths);
+      for (const generation of Object.values(result.readGenerations)) expect(generation).toBe(7);
+      expect(result.failedPaths).not.toContain("/m/150.wav");
