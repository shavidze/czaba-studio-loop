+const EMPTY_FOLDER = "/empty";
+
+function expectEmptyFolderState(): void {
+  const state = useFileStore.getState();
+  expect(state.metadata).toEqual({});
+  expect(state.files).toEqual([]);
+  expect(state.folderPath).toBe(EMPTY_FOLDER);
+  expect(vi.mocked(window.api.readMetadataBatch)).not.toHaveBeenCalled();
+  expect(useMetadataStore.getState().toastMessage).toBeNull();
+}
+
+describe("empty folder clears store metadata (TM-B32, D-37)", () => {
+  it("(e1) Open Folder of an empty folder clears the old folder's store entries and shows no toast", async () => {
+    seedTwoFiles([]);
+    vi.mocked(window.api.openFolderDialog).mockResolvedValue(EMPTY_FOLDER);
+    vi.mocked(window.api.scanFolder).mockResolvedValue([]);
+    renderBrowserAndPanel();
+
+    await clickButton(/Open Folder/);
+
+    expectEmptyFolderState();
+  });
+
+  it("(e2) App: dropping an empty folder clears the old folder's store entries and shows no toast", async () => {
+    vi.mocked(window.api.loadSchema).mockResolvedValue(STANDARD_FIELDS);
+    vi.mocked(window.api.resolveDroppedPaths).mockResolvedValue({ folders: [EMPTY_FOLDER], wavFiles: [] });
+    seedTwoFiles([]);
+    vi.mocked(window.api.scanFolder).mockResolvedValue([]);
+    const { container } = render(createElement(App));
+    const dropTarget = container.firstChild;
+    if (!(dropTarget instanceof Element)) throw new Error("App root not found");
+
+    await dropFolder(dropTarget);
+
+    expect(vi.mocked(window.api.scanFolder)).toHaveBeenCalledWith(EMPTY_FOLDER);
+    expectEmptyFolderState();
+  });
+
+  it("(e3) empty folder, then Open Folder of the old folder whose only read chunk rejects: no stale entry comes back and Failed to read 2 files is shown", async () => {
+    seedTwoFiles([]);
+    vi.mocked(window.api.openFolderDialog).mockResolvedValueOnce(EMPTY_FOLDER).mockResolvedValueOnce(FOLDER);
+    vi.mocked(window.api.scanFolder).mockResolvedValueOnce([]).mockResolvedValueOnce([FILE_A, FILE_B]);
+    vi.mocked(window.api.readMetadataBatch).mockRejectedValueOnce(new Error("ipc read failed"));
+    renderBrowserAndPanel();
+
+    await clickButton(/Open Folder/);
+    await clickButton(/Open Folder/);
+
+    const state = useFileStore.getState();
+    expect(vi.mocked(window.api.readMetadataBatch)).toHaveBeenCalledTimes(1);
+    expect(state.metadata).toEqual({});
+    expect(state.files).toEqual([FILE_A, FILE_B]);
+    expect(state.folderPath).toBe(FOLDER);
+    expect(useMetadataStore.getState().toastMessage).toBe("Failed to read 2 files");
+    expect(useMetadataStore.getState().toastType).toBe("error");
+  });
+
+  it("(e4) pin: Rescan of a folder that is now empty clears the store entries and shows no toast", async () => {
+    seedTwoFiles([]);
+    vi.mocked(window.api.scanFolder).mockResolvedValue([]);
+    renderBrowserAndPanel();
+
+    await clickButton(/Rescan/);
+
+    const state = useFileStore.getState();
+    expect(state.metadata).toEqual({});
+    expect(state.files).toEqual([]);
+    expect(vi.mocked(window.api.readMetadataBatch)).not.toHaveBeenCalled();
+    expect(useMetadataStore.getState().toastMessage).toBeNull();
+  });
+});
