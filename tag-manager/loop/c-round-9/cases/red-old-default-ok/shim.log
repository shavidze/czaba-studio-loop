sudo argv=[debconf-communicate] DF=noninteractive
debconf-communicate stdin=[set man-db/auto-update false] DF=noninteractive
sudo argv=[rm -f /var/lib/man-db/auto-update] DF=noninteractive
(sudo shim: rm not executed)
sudo argv=[env DEBIAN_FRONTEND=noninteractive timeout --kill-after=10 240 apt-get -o Dpkg::Use-Pty=0 update] DF=noninteractive
apt-get argv=[-o Dpkg::Use-Pty=0 update] DF=noninteractive
sudo argv=[env DEBIAN_FRONTEND=noninteractive timeout --kill-after=10 240 apt-get -o Dpkg::Use-Pty=0 install -y --no-install-recommends ffmpeg xvfb] DF=noninteractive
apt-get argv=[-o Dpkg::Use-Pty=0 install -y --no-install-recommends ffmpeg xvfb] DF=noninteractive
