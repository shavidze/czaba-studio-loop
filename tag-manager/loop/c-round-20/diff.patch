+describe("MetadataPanel save while the selection changes (TM-B23, D-29)", () => {
+  const SEED_A: WavMetadata = { ...taggedSeed("A-comment"), title: "A-title", category: "ACat" };
+  const SEED_B: WavMetadata = { ...taggedSeed("B-comment"), title: "B-title", category: "BCat" };
+  const REREAD_A: WavMetadata = { ...SEED_A, category: "R20Cat" };
+
+  interface PendingWrite {
+    release: () => void;
+    fail: (error: Error) => void;
+  }
+
+  function seedSingleA(): void {
+    seedTaggedFiles(SEED_A, SEED_B);
+    useFileStore.setState({ selectedPaths: [PATH_A] });
+  }
+
+  function seedBatchAB(): { seedA: WavMetadata; seedB: WavMetadata } {
+    const seedA = taggedSeed("old A");
+    const seedB = taggedSeed("old B");
+    seedTaggedFiles(seedA, seedB);
+    return { seedA, seedB };
+  }
+
+  function deferSingleWrite(): PendingWrite {
+    let resolveWrite: () => void = () => {};
+    let rejectWrite: (error: Error) => void = () => {};
+    vi.mocked(window.api.writeMetadata).mockReturnValueOnce(
+      new Promise<void>((resolve, reject) => {
+        resolveWrite = () => resolve();
+        rejectWrite = reject;
+      }),
+    );
+    return { release: () => resolveWrite(), fail: (error) => rejectWrite(error) };
+  }
+
+  function deferBatchWrite(result: BatchWriteResult): PendingWrite {
+    let resolveWrite: () => void = () => {};
+    let rejectWrite: (error: Error) => void = () => {};
+    vi.mocked(window.api.writeMetadataBatch).mockReturnValueOnce(
+      new Promise<BatchWriteResult>((resolve, reject) => {
+        resolveWrite = () => resolve(result);
+        rejectWrite = reject;
+      }),
+    );
+    return { release: () => resolveWrite(), fail: (error) => rejectWrite(error) };
+  }
+
+  function selectPaths(paths: string[]): void {
+    act(() => {
+      useFileStore.setState({ selectedPaths: paths });
+    });
+  }
+
+  async function settle(action: () => void): Promise<void> {
+    await act(async () => {
+      action();
+    });
+  }
+
+  async function typeCategoryAndSaveWith(value: string, saveButtonName: RegExp): Promise<void> {
+    fireEvent.change(getCategoryInput(), { target: { value } });
+    expect(getCategoryInput().value).toBe(value);
+    await clickSave(saveButtonName);
+    expect(useMetadataStore.getState().isSaving).toBe(true);
+  }
+
+  async function saveAThenSelectBAndSettle(): Promise<void> {
+    seedSingleA();
+    vi.mocked(window.api.readMetadata).mockResolvedValueOnce({ ...REREAD_A });
+    const pending = deferSingleWrite();
+    render(createElement(MetadataPanel));
+    expect(getCategoryInput().value).toBe("ACat");
+
+    await typeCategoryAndSaveWith("R20Cat", /Save Tags/);
+    selectPaths([PATH_B]);
+    expect(getCategoryInput().value).toBe("BCat");
+
+    await settle(pending.release);
+  }
+
+  it("(x1) single A -> B during the write: the editor shows B, A's re-read only goes to the store", async () => {
+    await saveAThenSelectBAndSettle();
+
+    const state = useMetadataStore.getState();
+    expect(getCategoryInput().value).toBe("BCat");
