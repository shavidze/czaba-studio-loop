+++ b/tests/renderer/utils/file-row-display.test.ts
@@ -1,6 +1,7 @@
 import { describe, expect, it } from "vitest";
 import { formatFirstFieldValue, hasAnyTagValue } from "~/lib/file-row-display";
 import type { FieldValue } from "~/types";
+import type { WavMetadata } from "~/types";
 
 describe("hasAnyTagValue", () => {
   it("returns false for undefined metadata", () => {
@@ -75,3 +76,63 @@ describe("formatFirstFieldValue", () => {
     expect(formatFirstFieldValue(["A", "B"])).toBe("A");
   });
 });
+
+function parseUntypedMetadata(json: string): WavMetadata {
+  return JSON.parse(json);
+}
+
+function parseUntypedFieldValue(json: string): FieldValue {
+  return JSON.parse(json);
+}
+
+describe("hasAnyTagValue with non-string array elements (TM-B20, D-26)", () => {
+  const malformedOnly: Array<[string]> = [
+    ['{"artists":[null]}'],
+    ['{"genres":[5]}'],
+    ['{"keywords":[{}]}'],
+    ['{"artists":[true]}'],
+  ];
+
+  it.each(malformedOnly)("(a) %s does not throw and returns false", (json) => {
+    const meta = parseUntypedMetadata(json);
+    expect(() => hasAnyTagValue(meta)).not.toThrow();
+    expect(hasAnyTagValue(meta)).toBe(false);
+  });
+
+  const mixedWithString: Array<[string]> = [
+    ['{"artists":["x",null]}'],
+    ['{"artists":[null," y "]}'],
+  ];
+
+  it.each(mixedWithString)("(b) %s returns true", (json) => {
+    expect(hasAnyTagValue(parseUntypedMetadata(json))).toBe(true);
+  });
+
+  it("(c) a malformed array next to a real comment returns true", () => {
+    expect(hasAnyTagValue(parseUntypedMetadata('{"artists":[null],"comment":"ok"}'))).toBe(true);
+  });
+
+  it("(c) a malformed array next to empty defaults returns false", () => {
+    expect(
+      hasAnyTagValue(
+        parseUntypedMetadata(
+          '{"title":"","artists":[null],"genres":[{}],"bpm":0,"keywords":[""],"comment":"   "}',
+        ),
+      ),
+    ).toBe(false);
+  });
+});
+
+describe("formatFirstFieldValue with non-string array elements (TM-B20, D-26)", () => {
+  const nonStringFirst: Array<[string]> = [["[null]"], ["[5]"], ["[{}]"], ["[true]"], ['[{},"A"]']];
+
+  it.each(nonStringFirst)("(d) %s returns an empty string", (json) => {
+    const result = formatFirstFieldValue(parseUntypedFieldValue(json));
+    expect(typeof result).toBe("string");
+    expect(result).toBe("");
+  });
+
+  it('(d) ["A",null] returns "A"', () => {
+    expect(formatFirstFieldValue(parseUntypedFieldValue('["A",null]'))).toBe("A");
+  });
+});
