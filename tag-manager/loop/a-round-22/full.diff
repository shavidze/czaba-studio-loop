+
+describe("FileList Shift-click anchor (TM-B25, D-31)", () => {
+  function selectedNames(): string[] {
+    return useFileStore
+      .getState()
+      .selectedPaths.map((path) => path.slice(FOLDER_PATH.length + 1))
+      .sort();
+  }
+
+  function renderPlainFiles(names: string[]): void {
+    const rows: Record<string, WavMetadata> = {};
+    for (const name of names) {
+      rows[name] = {};
+    }
+    renderFileListWith(rows);
+  }
+
+  const FOUR_FILES = ["a.wav", "b.wav", "c.wav", "d.wav"];
+
+  it("(z1) pin: click then Shift-click selects the range", () => {
+    renderPlainFiles(FOUR_FILES);
+
+    fireEvent.click(getFileRow("a.wav"));
+    fireEvent.click(getFileRow("c.wav"), { shiftKey: true });
+
+    expect(selectedNames()).toEqual(["a.wav", "b.wav", "c.wav"]);
+  });
+
+  it("(z2) keeps the anchor after the D-28 stats refresh of a save", () => {
+    renderPlainFiles(FOUR_FILES);
+
+    fireEvent.click(getFileRow("a.wav"));
+    act(() => {
+      useFileStore.getState().updateFileStats([{ ...createFileEntry("a.wav"), size: 2048 }]);
+    });
+    fireEvent.click(getFileRow("c.wav"), { shiftKey: true });
+
+    expect(selectedNames()).toEqual(["a.wav", "b.wav", "c.wav"]);
+  });
+
+  it("(z3) keeps the anchor after the metadata update of a save", () => {
+    renderPlainFiles(FOUR_FILES);
+
+    fireEvent.click(getFileRow("a.wav"));
+    act(() => {
+      useFileStore
+        .getState()
+        .updateFileMetadata(`${FOLDER_PATH}/a.wav`, createDefaultMetadata({ title: "T" }));
+    });
+    fireEvent.click(getFileRow("c.wav"), { shiftKey: true });
+
+    expect(selectedNames()).toEqual(["a.wav", "b.wav", "c.wav"]);
+  });
+
+  it("(z4) the anchor follows the item after a sort direction change", () => {
+    renderPlainFiles([...FOUR_FILES, "e.wav"]);
+
+    fireEvent.click(getFileRow("b.wav"));
+    act(() => {
+      useFileStore.getState().toggleSortDirection();
+    });
+    expect(getRowNamesInOrder()).toEqual(["e.wav", "d.wav", "c.wav", "b.wav", "a.wav"]);
+    fireEvent.click(getFileRow("e.wav"), { shiftKey: true });
+
+    expect(selectedNames()).toEqual(["b.wav", "c.wav", "d.wav", "e.wav"]);
+  });
+
+  it("(z5) keeps the anchor after a search change that keeps it visible", () => {
+    renderPlainFiles(FOUR_FILES);
+
+    fireEvent.click(getFileRow("a.wav"));
+    act(() => {
+      useFileStore.getState().setSearchQuery(".wav");
+    });
+    fireEvent.click(getFileRow("c.wav"), { shiftKey: true });
+
+    expect(selectedNames()).toEqual(["a.wav", "b.wav", "c.wav"]);
+  });
+
+  it("(z6) pin: a search that hides the anchor selects only the clicked row", () => {
+    renderPlainFiles(FOUR_FILES);
+
+    fireEvent.click(getFileRow("a.wav"));
+    act(() => {
+      useFileStore.getState().setSearchQuery("c");
+    });
+    fireEvent.click(getFileRow("c.wav"), { shiftKey: true });
+
+    expect(selectedNames()).toEqual(["c.wav"]);
+  });
+
+  it("(z7) pin: a rescan drops the anchor", () => {
+    renderPlainFiles(FOUR_FILES);
+
+    fireEvent.click(getFileRow("a.wav"));
+    act(() => {
+      useFileStore.getState().clearSelection();
+      useFileStore.getState().setFiles(FOUR_FILES.map(createFileEntry));
+    });
+    fireEvent.click(getFileRow("c.wav"), { shiftKey: true });
+
+    expect(selectedNames()).toEqual(["c.wav"]);
+  });
+
+  it("(z8) Deselect All drops the anchor (new D-31 behaviour)", () => {
+    renderPlainFiles(FOUR_FILES);
+
+    fireEvent.click(getFileRow("a.wav"));
+    act(() => {
+      useFileStore.getState().clearSelection();
+    });
+    fireEvent.click(getFileRow("c.wav"), { shiftKey: true });
+
+    expect(selectedNames()).toEqual(["c.wav"]);
+  });
+
+  it("(z9) pin: Shift-click without an earlier click selects only the clicked row", () => {
+    renderPlainFiles(FOUR_FILES);
+
+    fireEvent.click(getFileRow("c.wav"), { shiftKey: true });
+
+    expect(selectedNames()).toEqual(["c.wav"]);
+  });
+
+  it("(z10) pin: Ctrl-click sets the anchor and the range is added", () => {
+    renderPlainFiles(FOUR_FILES);
+
+    fireEvent.click(getFileRow("a.wav"));
+    fireEvent.click(getFileRow("c.wav"), { ctrlKey: true });
+    fireEvent.click(getFileRow("d.wav"), { shiftKey: true });
+
+    expect(selectedNames()).toEqual(["a.wav", "c.wav", "d.wav"]);
+  });
+
+  it("(z11) the anchor follows the item after a save and a sort field change", () => {
+    renderFileListWith({
+      "a.wav": { bpm: 3 },
+      "b.wav": { bpm: 1 },
+      "c.wav": { bpm: 2 },
+      "d.wav": { bpm: 4 },
+    });
+
+    fireEvent.click(getFileRow("a.wav"));
+    act(() => {
+      useFileStore
+        .getState()
+        .updateFileMetadata(`${FOLDER_PATH}/a.wav`, createDefaultMetadata({ bpm: 3 }));
+    });
+    act(() => {
+      useFileStore.getState().setSortField("bpm");
+    });
+    expect(getRowNamesInOrder()).toEqual(["b.wav", "c.wav", "a.wav", "d.wav"]);
+    fireEvent.click(getFileRow("d.wav"), { shiftKey: true });
+
+    expect(selectedNames()).toEqual(["a.wav", "d.wav"]);
+  });
+});
