+const GRID_OFFSET_TOLERANCE = 0.0005;
+
+function isOnGrid(time: number, step: number): boolean {
+  return Math.abs(snapTimeToGrid(time, step) - time) < GRID_OFFSET_TOLERANCE;
+}
+
+function relativeGridStart(anchorStart: number, rawDelta: number, step: number): number {
+  if (isOnGrid(anchorStart, step)) {
+    return snapTimeToGrid(anchorStart + rawDelta, step);
+  }
+  const baseIndex = Math.floor((anchorStart + GRID_TIME_TOLERANCE) / step);
+  const offset = anchorStart - storedGridLine(baseIndex, step);
+  const whole = Math.max(-baseIndex, Math.floor(rawDelta / step + 0.5));
+  return roundGridTime(storedGridLine(baseIndex + whole, step) + offset);
+}
+
+export function snapRelativeMoveStartToGridOrEdges(
+  anchorStart: number,
+  rawDelta: number,
+  duration: number,
+  step: number,
+  edges: readonly number[],
+  endEdges: readonly number[] = edges,
+): number {
+  return nearestGridOrEdge(anchorStart + rawDelta, relativeGridStart(anchorStart, rawDelta, step), [
+    ...edges,
+    ...endEdges.map((edge) => edge - duration),
+  ]);
+}
+
+function relativeGroupDelta(
+  anchorStart: number,
+  rawDelta: number,
+  step: number,
+  minDelta: number,
+  maxDelta: number,
+): number {
+  if (isOnGrid(anchorStart, step)) {
+    return snapGroupDelta(anchorStart, rawDelta, step, minDelta, maxDelta);
+  }
+  const requested = roundGridTime(relativeGridStart(anchorStart, rawDelta, step) - anchorStart);
+  if (requested >= minDelta - GRID_TIME_TOLERANCE && requested <= maxDelta + GRID_TIME_TOLERANCE) {
+    return requested;
+  }
+  const whole =
+    requested > 0
+      ? Math.max(0, Math.floor((maxDelta + GRID_TIME_TOLERANCE) / step))
+      : Math.min(0, Math.ceil((minDelta - GRID_TIME_TOLERANCE) / step));
+  return roundGridTime(whole * step);
+}
