+    const covered = baseArrangement([clip('a', 'music', 10, 2.5), clip('b', 'music', 20, 5)]);
+    expect(splitClipsByRange(covered, { start: 9, end: 13, trackId: 'music' })).toBeNull();
+  });
+
+  it('MS4: an edge closer than the minimum to a clip edge is not cut; the other edge is', () => {
+    const atStart = splitClipsByRange(baseArrangement([clip('a', 'music', 0, 10)]), {
+      start: 0.03,
+      end: 6,
+      trackId: 'music',
+    });
+    expect(atStart).not.toBeNull();
+    if (!atStart) return;
+    expect(spans(atStart.arrangement)).toEqual([
+      ['music', 'src', 0, 0, 6],
+      ['music', 'src', 6, 6, 4],
+    ]);
+    expect(atStart.middleIds).toEqual(['a']);
+    const atEnd = splitClipsByRange(baseArrangement([clip('a', 'music', 0, 10)]), {
