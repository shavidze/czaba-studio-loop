+  function spans(arrangement: Arrangement): Array<[string, string, number, number, number]> {
+    return arrangement.clips
+      .map((entry): [string, string, number, number, number] => [
+        entry.trackId,
+        entry.sourceId,
+        Number(entry.start.toFixed(6)),
+        Number(entry.sourceOffset.toFixed(6)),
+        Number(entry.duration.toFixed(6)),
+      ])
+      .sort((left, right) => left[0].localeCompare(right[0]) || left[2] - right[2]);
+  }
+
+  it('MS1: a range past the clip start cuts only at the edge inside the clip', () => {
+    const result = splitClipsByRange(baseArrangement([clip('a', 'music', 10, 101.35)]), {
+      start: 6.25,
+      end: 12.5,
+      trackId: 'music',
+    });
+    expect(result).not.toBeNull();
+    if (!result) return;
+    expect(spans(result.arrangement)).toEqual([
+      ['music', 'src', 10, 0, 2.5],
+      ['music', 'src', 12.5, 2.5, 98.85],
+    ]);
+    expect(result.middleIds).toEqual(['a']);
+    expect(find(result.arrangement, 'a')).toMatchObject({ start: 10, duration: 2.5 });
+  });
+
+  it('MS2: a range across a gap cuts both clips and returns both inside parts in clip order', () => {
+    const result = splitClipsByRange(
+      baseArrangement([clip('b', 'music', 14, 10, 0, 'srcB'), clip('a', 'music', 0, 10)]),
+      { start: 6, end: 18, trackId: 'music' },
+    );
+    expect(result).not.toBeNull();
+    if (!result) return;
+    expect(spans(result.arrangement)).toEqual([
+      ['music', 'src', 0, 0, 6],
+      ['music', 'src', 6, 6, 4],
+      ['music', 'srcB', 14, 0, 4],
+      ['music', 'srcB', 18, 4, 6],
+    ]);
+    expect(result.middleIds).toHaveLength(2);
+    expect(find(result.arrangement, result.middleIds[0] ?? '')).toMatchObject({
+      sourceId: 'src',
+      start: 6,
+      sourceOffset: 6,
+      duration: 4,
+    });
+    expect(result.middleIds[0]).not.toBe('a');
+    expect(result.middleIds[1]).toBe('b');
+    expect(find(result.arrangement, 'b')).toMatchObject({
+      start: 14,
+      sourceOffset: 0,
+      duration: 4,
+    });
+  });
+
+  it('MS3: empty space only, or a whole clip inside the range, is refused', () => {
