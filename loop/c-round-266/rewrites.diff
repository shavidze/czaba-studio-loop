+        clip('b', 'music', 10.02, 4.98, 0, 'srcB'),
+        clip('t', 'music', 15, 5, 0, 'srcT'),
+      ]),
+      { start: 4, end: 10.05, trackId: 'music' },
+    );
+    expect(cut).not.toBeNull();
+    if (!cut) return;
+    expect(spans(cut.arrangement)).toEqual([
+      ['music', 'src', 0, 0, 4],
+      ['music', 'src', 4, 4, 6],
+      ['music', 'srcB', 10.02, 0, 4.98],
+      ['music', 'srcT', 15, 0, 5],
+    ]);
+    expect(cut.middleIds).toHaveLength(1);
+    expect(cut.middleIds).not.toContain('b');
+    const touching = splitClipsByRange(
+      baseArrangement([clip('a', 'music', 0, 4), clip('b', 'music', 6, 4, 0, 'srcB')]),
+      { start: 4, end: 6, trackId: 'music' },
+    );
+    expect(touching).toBeNull();
+  });
