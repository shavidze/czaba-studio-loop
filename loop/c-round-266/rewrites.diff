+
+  it('MS5: clips on another track in the same time window are untouched', () => {
+    const other = clip('s', 'stems', 0, 10, 0, 'srcS');
+    const result = splitClipsByRange(baseArrangement([clip('a', 'music', 0, 10), other]), {
+      start: 4,
+      end: 6,
+      trackId: 'music',
+    });
+    expect(result).not.toBeNull();
+    if (!result) return;
+    expect(spans(result.arrangement)).toEqual([
+      ['music', 'src', 0, 0, 4],
