+
+  it('MS6: a whole clip inside the range next to a cut clip is selected uncut', () => {
+    const result = splitClipsByRange(
+      baseArrangement([clip('a', 'music', 0, 10), clip('b', 'music', 12, 2, 0, 'srcB')]),
+      { start: 6, end: 15, trackId: 'music' },
+    );
+    expect(result).not.toBeNull();
+    if (!result) return;
+    expect(spans(result.arrangement)).toEqual([
+      ['music', 'src', 0, 0, 6],
+      ['music', 'src', 6, 6, 4],
+      ['music', 'srcB', 12, 0, 2],
