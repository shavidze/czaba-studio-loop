+function focusPastHiddenOverview(): void {
+  const focused = document.activeElement;
+  const overview =
+    focused instanceof HTMLElement
+      ? focused.closest<HTMLElement>('[data-timeline-overview]')
+      : null;
+  const dock = overview?.closest<HTMLElement>('[data-testid="arrangement-video-dock"]');
+  if (!overview || !dock) {
+    return;
+  }
+  const next = [...dock.querySelectorAll<HTMLButtonElement>('button')].find(
+    (button) =>
+      !button.disabled &&
+      button.tabIndex >= 0 &&
+      (overview.compareDocumentPosition(button) & Node.DOCUMENT_POSITION_FOLLOWING) !== 0,
+  );
+  next?.focus({ preventScroll: true });
+}
