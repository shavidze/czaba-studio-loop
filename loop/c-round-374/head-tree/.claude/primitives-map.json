{
  "primitivesDir": ".claude/primitives",
  "rules": [
    { "pattern": "^app/components/.*\\.tsx$", "primitives": ["FORWARDREF_COMPONENT.md", "DESIGN_TOKENS.md", "TAILWIND_FIRST.md"] },
    { "pattern": "^app/contexts/.*\\.tsx?$", "primitives": ["REACT_CONTEXT.md"] },
    { "pattern": "^app/services/.*\\.ts$", "primitives": ["API_ERROR_HANDLING.md"] },
    { "pattern": "(audio|studio|wavesurfer)", "primitives": ["AUDIO_ARCHITECTURE.md"] },
    { "pattern": "^docs/.*\\.md$", "primitives": ["GEORGIAN_DOCS.md"] },
    { "pattern": "^app/.*\\.tsx?$", "primitives": ["AGENT_DISCOVERABLE_CODE.md"] }
  ]
}
