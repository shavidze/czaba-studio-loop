{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Czaba Store Design Tokens — W3C DTCG ფორმატი",
  "color": {
    "$type": "color",
    "brand": {
      "$value": "hsl(175, 85%, 46%)",
      "$description": "Primary actions, links — #13D9CC Teal"
    },
    "brand-hover": {
      "$value": "hsl(175, 85%, 52%)",
      "$description": "Brand hover state"
    },
    "brand-foreground": {
      "$value": "hsl(220, 20%, 4%)",
      "$description": "ტექსტი brand ფონზე"
    },
    "accent": {
      "$value": "#F9A80C",
      "$description": "Secondary accent — Orange"
    },
    "background": {
      "$value": "hsl(220, 20%, 4%)",
      "$description": "გვერდის ფონი — #0A0B0F"
    },
    "surface": {
      "$value": "hsl(220, 18%, 8%)",
      "$description": "ბარათები, მოდალები — #121318"
    },
    "elevated": {
      "$value": "hsl(220, 18%, 12%)",
      "$description": "Hover states — #1A1B21"
    },
    "muted-bg": {
      "$value": "hsl(220, 15%, 15%)",
      "$description": "Muted backgrounds"
    },
    "foreground": {
      "$value": "hsl(220, 10%, 94%)",
      "$description": "ძირითადი ტექსტი — #EEEEF0"
    },
    "muted": {
      "$value": "hsl(220, 10%, 55%)",
      "$description": "მეორეული ტექსტი — #85858F"
    },
    "dim": {
      "$value": "hsl(220, 10%, 45%)",
      "$description": "გამორთული, მინიშნებები"
    },
    "outline": {
      "$value": "hsl(220, 15%, 22%)",
      "$description": "ბორდერები — #333640"
    },
    "outline-hover": {
      "$value": "hsl(220, 15%, 28%)",
      "$description": "Hover ბორდერები — #434750"
    },
    "outline-strong": {
      "$value": "hsl(220, 15%, 32%)",
      "$description": "Focus ბორდერები"
    },
    "positive": {
      "$value": "#00D26A",
      "$description": "წარმატების ფერი"
    },
    "destructive": {
      "$value": "hsl(0, 84%, 60%)",
      "$description": "შეცდომის ფერი"
    },
    "warning": {
      "$value": "#F59E0B",
      "$description": "გაფრთხილების ფერი"
    },
    "info": {
      "$value": "#3B82F6",
      "$description": "ინფორმაციის ფერი"
    },
    "buy": {
      "$value": "#006AFF",
      "$description": "შეძენის ღილაკი"
    },
    "buy-hover": {
      "$value": "#0052CC",
      "$description": "შეძენის ღილაკი hover"
    },
    "crystal": {
      "cyan": { "$value": "#22D3EE" },
      "blue": { "$value": "#3B82F6" },
      "purple": { "$value": "#8B5CF6" },
      "green": { "$value": "#10B981" }
    },
    "premium": {
      "amber": { "$value": "#F59E0B" },
      "gold": { "$value": "#FBBF24" },
      "rose": { "$value": "#F43F5E" }
    },
    "glow": {
      "primary": {
        "$value": "hsl(175, 85%, 46%)",
        "$description": "Teal glow"
      },
      "secondary": {
        "$value": "hsl(38, 95%, 55%)",
        "$description": "Orange glow"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "0": { "$value": "0px" },
    "1": { "$value": "0.25rem", "$description": "4px — Micro spacing" },
    "2": { "$value": "0.5rem", "$description": "8px — Small elements" },
    "3": { "$value": "0.75rem", "$description": "12px — Compact" },
    "4": { "$value": "1rem", "$description": "16px — Standard padding" },
    "5": { "$value": "1.25rem", "$description": "20px" },
    "6": { "$value": "1.5rem", "$description": "24px — Card padding" },
    "8": { "$value": "2rem", "$description": "32px — Section spacing" },
    "10": { "$value": "2.5rem", "$description": "40px" },
    "12": { "$value": "3rem", "$description": "48px — Large sections" },
    "16": { "$value": "4rem", "$description": "64px — Section dividers" },
    "20": { "$value": "5rem", "$description": "80px — Hero sections" },
    "24": { "$value": "6rem", "$description": "96px" }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": { "$value": "Inter", "$description": "Body, UI, labels" },
      "serif": { "$value": "Playfair Display", "$description": "Headlines" }
    },
    "fontWeight": {
      "$type": "number",
      "light": { "$value": 300 },
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "extrabold": { "$value": 800 }
    },
    "fontSize": {
      "$type": "dimension",
      "xs": { "$value": "0.75rem", "$description": "12px" },
      "sm": { "$value": "0.875rem", "$description": "14px" },
      "base": { "$value": "1rem", "$description": "16px" },
      "lg": { "$value": "1.25rem", "$description": "20px" },
      "xl": { "$value": "1.5rem", "$description": "24px" },
      "2xl": { "$value": "1.875rem", "$description": "30px" },
      "3xl": { "$value": "2.25rem", "$description": "36px" },
      "4xl": { "$value": "3rem", "$description": "48px" },
      "5xl": { "$value": "3.75rem", "$description": "60px" },
      "6xl": { "$value": "4.5rem", "$description": "72px" }
    },
    "lineHeight": {
      "$type": "dimension",
      "xs": { "$value": "16px" },
      "sm": { "$value": "20px" },
      "base": { "$value": "24px" },
      "lg": { "$value": "28px" },
      "xl": { "$value": "32px" },
      "2xl": { "$value": "36px" },
      "3xl": { "$value": "40px" },
      "4xl": { "$value": "52px" },
      "5xl": { "$value": "64px" },
      "6xl": { "$value": "76px" }
    }
  },
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": "0 1px 2px hsl(220, 20%, 2%, 0.3)",
      "$description": "Subtle elevation"
    },
    "md": {
      "$value": "0 2px 8px hsl(220, 20%, 2%, 0.4)",
      "$description": "ბარათები"
    },
    "lg": {
      "$value": "0 4px 16px hsl(220, 20%, 2%, 0.5)",
      "$description": "მოდალები"
    },
    "xl": {
      "$value": "0 8px 32px hsl(220, 20%, 2%, 0.6)",
      "$description": "Elevated elements"
    },
    "glow": {
      "$value": "0 0 40px hsl(175, 85%, 46%, 0.15)",
      "$description": "Teal glow effect"
    },
    "glow-accent": {
      "$value": "0 0 40px hsl(38, 95%, 55%, 0.15)",
      "$description": "Orange glow effect"
    },
    "card": {
      "$value": "0 8px 32px hsl(220, 20%, 2%, 0.4)",
      "$description": "Card shadow"
    },
    "elevated": {
      "$value": "0 16px 48px hsl(220, 20%, 2%, 0.6)",
      "$description": "Elevated shadow"
    }
  },
  "borderRadius": {
    "$type": "dimension",
    "sm": { "$value": "0.375rem", "$description": "6px — Tags" },
    "md": { "$value": "0.5rem", "$description": "8px — Buttons, inputs" },
    "lg": { "$value": "0.75rem", "$description": "12px — Cards" },
    "xl": { "$value": "1rem", "$description": "16px — Large cards" },
    "full": { "$value": "9999px", "$description": "Pills, avatars" }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": "640px", "$description": "Large phones" },
    "md": { "$value": "768px", "$description": "Tablets" },
    "lg": { "$value": "1024px", "$description": "Small desktops" },
    "xl": { "$value": "1280px", "$description": "Desktops" },
    "2xl": { "$value": "1536px", "$description": "Large desktops" }
  },
  "animation": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "150ms", "$description": "Hover, focus" },
      "normal": { "$value": "250ms", "$description": "Transitions" },
      "slow": { "$value": "400ms", "$description": "Complex animations" }
    },
    "easing": {
      "$type": "cubicBezier",
      "out": { "$value": [0.16, 1, 0.3, 1], "$description": "ელემენტის გამოჩენა" },
      "in-out": { "$value": [0.65, 0, 0.35, 1], "$description": "ტრანზიციები" },
      "bounce": { "$value": [0.34, 1.56, 0.64, 1], "$description": "Click feedback" }
    }
  },
  "container": {
    "maxWidth": {
      "$type": "dimension",
      "$value": "1280px"
    },
    "modal": {
      "$type": "dimension",
      "$value": "420px"
    },
    "modal-lg": {
      "$type": "dimension",
      "$value": "560px"
    }
  }
}
