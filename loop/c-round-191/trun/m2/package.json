{
  "name": "music-store",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "remix vite:dev",
    "build": "remix vite:build",
    "start": "remix-serve build/server/index.js",
    "dev:debug": "node --inspect npx remix vite:dev",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "docs": "npx docsify-cli serve docs/technical --port 4000",
    "prepare": "husky",
    "lint": "biome lint ./app",
    "format": "biome format --write ./app",
    "check": "biome check ./app",
    "check:fix": "biome check --write ./app",
    "typecheck": "tsc --noEmit",
    "agents:check": "node scripts/check-agents.mjs",
    "test:agents": "node --test scripts/agent-hooks.test.mjs",
    "test:e2e:smoke": "playwright test --config playwright.smoke.config.ts",
    "verify": "npm run agents:check && npm run test:agents && npm run lint && npm run typecheck && npm run test:run && npm run build"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.958.0",
    "@aws-sdk/s3-request-presigner": "^3.958.0",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@microsoft/signalr": "^8.0.7",
    "@remix-run/node": "^2.12.0",
    "@remix-run/react": "^2.12.0",
    "@remix-run/serve": "^2.17.2",
    "@tailwindcss/vite": "^4.1.18",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "firebase": "^12.6.0",
    "firebase-admin": "^13.6.0",
    "framer-motion": "^12.23.26",
    "isbot": "^5.1.0",
    "lenis": "^1.3.17",
    "lucide-react": "^0.561.0",
    "pako": "^2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.4.0",
    "wavesurfer.js": "^7.12.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@playwright/test": "^1.57.0",
    "@remix-run/dev": "^2.12.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.1",
    "@types/pako": "^2.0.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.22",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.6.2",
    "vite": "^5.4.6",
    "vitest": "^4.0.16"
  }
}
