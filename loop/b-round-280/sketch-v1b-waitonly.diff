--- a/perf/lib/app-labels.ts	2026-10-31 02:30:48.000000000 +0000
+++ b/perf/lib/app-labels.ts	2026-10-31 02:38:35.112756510 +0000
@@ -32,6 +32,29 @@
 export const perfCollectionReadyPattern = new RegExp(
   `^${escapeRegExp(workspaceCollectionCopy('demo').ready)}`,
 );
+
+function countedTemplatePattern(render: (count: number) => string): string {
+  return [1, 2]
+    .map((count) => {
+      const rendered = render(count);
+      const digits = String(count);
+      const at = rendered.indexOf(digits);
+      if (at < 0 || rendered.indexOf(digits, at + digits.length) >= 0) {
+        throw new Error(`count template needs exactly one count: ${JSON.stringify(rendered)}`);
+      }
+      const before = escapeRegExp(rendered.slice(0, at));
+      const after = escapeRegExp(rendered.slice(at + digits.length));
+      return `${before}\\d+${after}`;
+    })
+    .join('|');
+}
+
+export const perfCollectionFailedPattern = new RegExp(
+  `^(?:${countedTemplatePattern(workspaceCollectionCopy('demo').failed)})`,
+);
+export const perfCollectionSettledPattern = new RegExp(
+  `${perfCollectionReadyPattern.source}|${perfCollectionFailedPattern.source}`,
+);
 export const perfActiveTrackLabel = (name: string): string =>
   studioLaneStrings.activeTrackLabel(name);
 
