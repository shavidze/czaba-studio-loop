.aria-disabled\:cursor-not-allowed {
  &[aria-disabled="true"] {
    cursor: not-allowed;
  }
}
.aria-disabled\:opacity-40 {
  &[aria-disabled="true"] {
    opacity: 40%;
  }
}
.aria-disabled\:\*\:opacity-40 {
  &[aria-disabled="true"] {
    :is(& > *) {
      opacity: 40%;
    }
  }
