+export function moveMarker(arrangement: Arrangement, id: string, time: number): MoveMarkerResult {
+  const markers = arrangementMarkers(arrangement);
+  const current = markers.find((marker) => marker.id === id);
+  if (!current) {
+    return { kind: 'unchanged', arrangement };
+  }
+  const at = roundMarkerTime(time);
+  if (Math.abs(at - current.time) < MARKER_TIME_EPS) {
+    return { kind: 'unchanged', arrangement };
+  }
+  const other = markers.find(
+    (marker) => marker.id !== id && Math.abs(marker.time - at) < MARKER_TIME_EPS,
+  );
+  if (other) {
+    return { kind: 'conflict', arrangement, other };
+  }
+  const marker: ArrangementMarker = { ...current, time: at };
+  return {
+    kind: 'moved',
+    arrangement: replaceArrangementMarkers(
+      arrangement,
+      sortMarkersByTime(markers.map((entry) => (entry.id === id ? marker : entry))),
+    ),
+    marker,
+  };
+}
