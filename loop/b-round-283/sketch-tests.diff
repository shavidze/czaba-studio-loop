+describe('PERF-3a zoom keeps the envelope line (ZQ3)', () => {
+  it('ZQ3 zoom 40 → 50 → 62.5 → 80 px/s writes no points or viewBox; only the width follows the zoom', async () => {
+    const { api, clipRoot } = await mountEnvelopeWorkspace([
+      clipAt('s1', 'stems', 2, 16, { envelope: V_ENVELOPE }),
+    ]);
+    const svg = clipRoot('s1').querySelector<SVGSVGElement>(`[data-testid="${LINE}"]`);
+    if (!svg) {
+      throw new Error('envelope line missing');
+    }
+    const before = svg.querySelector('polyline')?.getAttribute('points');
+    expect(svg.getAttribute('viewBox')).toBe('0 0 16 1');
+    expect(Number.parseFloat(svg.style.width)).toBe(16 * PX_PER_SECOND);
+    const observer = new MutationObserver(() => undefined);
+    observer.observe(svg, {
+      subtree: true,
+      attributes: true,
+      attributeFilter: ['points', 'viewBox'],
+    });
+    for (const zoom of [50, 62.5, 80]) {
+      act(() => live(api).setPxPerSecond(zoom));
+      const current = clipRoot('s1').querySelector<SVGSVGElement>(`[data-testid="${LINE}"]`);
+      expect(current).toBe(svg);
+      expect(Number.parseFloat(current?.style.width ?? 'NaN')).toBe(16 * zoom);
+      expect(current?.querySelector('polyline')?.getAttribute('points')).toBe(before);
+    }
+    const records = observer.takeRecords();
+    observer.disconnect();
+    expect(records.map((record) => record.attributeName)).toStrictEqual([]);
+  });
+});
