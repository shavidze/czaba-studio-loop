+    const transport = within(dialog).getByRole('region', { name: 'Transport' });
+    const ids = Array.from(transport.querySelectorAll<HTMLElement>('[data-shortcut-id]')).map(
+      (row) => row.dataset.shortcutId,
+    );
+    expect(ids.slice(0, TRANSPORT_ROWS.length)).toEqual(TRANSPORT_ROWS.map((row) => row.id));
+    for (const expected of TRANSPORT_ROWS) {
+      expect(within(dialog).getAllByText(expected.action), expected.id).toHaveLength(1);
+      const row = shortcutRow(dialog, expected.id);
