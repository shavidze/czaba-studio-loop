+function markerLine(mounted: MarkerMount): HTMLElement {
+  const lines = mounted.view.container.querySelectorAll<HTMLElement>(
+    '[data-testid="arrangement-insert-marker"]',
+  );
+  expect(lines).toHaveLength(1);
+  return lines[0];
+}
+
+function lineLeftFor(seconds: number, pxPerSecond = PX_PER_SECOND): string {
+  return `${ARRANGEMENT_HEADER_WIDTH_PX + seconds * pxPerSecond}px`;
+}
+
+function clickEmptyLane(mounted: MarkerMount, trackId: string, seconds: number) {
+  const body = mounted.view.container.querySelector<HTMLElement>(
+    `[data-track-id="${trackId}"] [data-grid-seconds]`,
+  );
+  if (!body) {
+    throw new Error(`lane ${trackId} not rendered`);
+  }
+  const rows = Array.from(mounted.view.container.querySelectorAll<HTMLElement>('[data-track-id]'));
+  const index = rows.findIndex((row) => row.dataset.trackId === trackId);
+  const clientX = seconds * PX_PER_SECOND;
+  const clientY = index * LANE_HEIGHT_PX + LANE_HEIGHT_PX / 2;
+  fireEvent.pointerDown(body, { ...press, pointerId: 3, clientX, clientY });
+  fireEvent.pointerUp(window, { pointerId: 3, clientX, clientY });
+}
