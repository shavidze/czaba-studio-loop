import { act, render } from '@testing-library/react';
import type { ReactNode } from 'react';
import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
import { StudioWorkspace } from '~/components/arrangement/StudioWorkspace';
import { ArrangementProvider } from '~/contexts/ArrangementContext';
import type { WorkspaceCollection, WorkspaceSource } from '~/types/arrangement';
import { createArrangement } from '../model';

vi.mock('@remix-run/react', () => ({
  Link: ({ to, children, className }: { to: string; children: ReactNode; className?: string }) => (
    <a href={to} className={className}>
      {children}
    </a>
  ),
}));

const fakeClock = { base: 0 };

class FakeParam {
  value = 0;
  setTargetAtTime(target: number) {
    this.value = target;
  }
}

class FakeNode {
  connect(destination: FakeNode) {
    return destination;
  }
  disconnect() {}
}

class FakeGain extends FakeNode {
  gain = new FakeParam();
}

class FakePanner extends FakeNode {
  pan = new FakeParam();
}

class FakeSource extends FakeNode {
  buffer: unknown = null;
  onended: (() => void) | null = null;
  start() {}
  stop() {}
}

class FakeAudioContext {
  state = 'running';
  destination = new FakeNode();
  sampleRate = 48000;
  get currentTime() {
    return Date.now() / 1000 - fakeClock.base;
  }
  resume() {
    return Promise.resolve();
  }
  close() {
    return Promise.resolve();
  }
  createGain() {
    return new FakeGain();
  }
  createStereoPanner() {
    return new FakePanner();
  }
  createBufferSource() {
    return new FakeSource();
  }
}

class FakeOfflineAudioContext {}

class FakeAudioBuffer {
  readonly length: number;
  readonly numberOfChannels: number;
  readonly sampleRate: number;
  constructor(options: { length: number; numberOfChannels: number; sampleRate: number }) {
    this.length = options.length;
    this.numberOfChannels = options.numberOfChannels;
    this.sampleRate = options.sampleRate;
  }
  get duration() {
    return this.length / this.sampleRate;
  }
  getChannelData() {
    return new Float32Array(this.length);
  }
}

const resizeCallbacks = new Set<() => void>();

class ControlledResizeObserver {
  private readonly callback: () => void;
  constructor(callback: () => void) {
    this.callback = callback;
  }
  observe() {
    resizeCallbacks.add(this.callback);
  }
  disconnect() {
    resizeCallbacks.delete(this.callback);
  }
}

const focusRevealCollection: WorkspaceCollection = {
  id: 'focus-reveal',
  label: 'focus-reveal',
  origin: 'demo',
  sources: [
    {
      id: 'song',
      title: 'Song',
      collectionLabel: 'focus-reveal',
      kind: 'music',
      origin: 'demo',
    },
  ],
  loadSource: async (_source: WorkspaceSource) =>
    new AudioBuffer({ length: 4000, numberOfChannels: 1, sampleRate: 100 }),
};

function fireTimelineResize() {
  act(() => {
    for (const callback of resizeCallbacks) {
      callback();
    }
  });
}

interface ScrollWriteLog {
  scrollTop: number[];
  scrollLeft: number[];
  scrollCalls: number;
}

function trackScrollWrites(scroller: HTMLElement): ScrollWriteLog {
  const log: ScrollWriteLog = { scrollTop: [], scrollLeft: [], scrollCalls: 0 };
  Object.defineProperty(scroller, 'scrollTop', {
    configurable: true,
    get: () => 37,
    set: (value: number) => {
      log.scrollTop.push(value);
    },
  });
  Object.defineProperty(scroller, 'scrollLeft', {
    configurable: true,
    get: () => 120,
    set: (value: number) => {
      log.scrollLeft.push(value);
    },
  });
  const countScrollCall = () => {
    log.scrollCalls += 1;
  };
  Object.defineProperty(scroller, 'scrollTo', { configurable: true, value: countScrollCall });
  Object.defineProperty(scroller, 'scrollBy', { configurable: true, value: countScrollCall });
  return log;
}

async function mountFocusRevealWorkspace() {
  const view = render(
    <ArrangementProvider
      collection={focusRevealCollection}
      initialArrangement={createArrangement([
        { id: 'video', kind: 'video', name: 'Video' },
        { id: 'music', kind: 'audio', name: 'Music' },
      ])}
    >
      <StudioWorkspace />
    </ArrangementProvider>,
  );
  for (let tick = 0; tick < 4; tick++) {
    await act(async () => {
      await Promise.resolve();
      await Promise.resolve();
    });
  }
  const scroller = view.getByTestId('arrangement-timeline-scroller');
  const timeline = scroller.firstElementChild;
  const chrome = timeline?.firstElementChild;
  if (!(chrome instanceof HTMLElement) || !chrome.className.includes('sticky top-0')) {
    throw new Error('timeline chrome not rendered');
  }
  let chromeHeight = 0;
  Object.defineProperty(chrome, 'offsetHeight', {
    configurable: true,
    get: () => chromeHeight,
  });
  const setChromeHeight = (height: number) => {
    chromeHeight = height;
  };
  return { view, scroller, setChromeHeight };
}

beforeEach(() => {
  fakeClock.base = Date.now() / 1000;
  resizeCallbacks.clear();
  vi.stubGlobal('AudioContext', FakeAudioContext);
  vi.stubGlobal('OfflineAudioContext', FakeOfflineAudioContext);
  vi.stubGlobal('AudioBuffer', FakeAudioBuffer);
  vi.stubGlobal('ResizeObserver', ControlledResizeObserver);
  vi.stubGlobal('requestAnimationFrame', () => 1);
  vi.stubGlobal('cancelAnimationFrame', () => undefined);
  vi.spyOn(HTMLMediaElement.prototype, 'pause').mockImplementation(() => undefined);
  vi.spyOn(HTMLMediaElement.prototype, 'play').mockImplementation(() => Promise.resolve());
  vi.spyOn(HTMLMediaElement.prototype, 'load').mockImplementation(() => undefined);
});

afterEach(() => {
  vi.unstubAllGlobals();
  vi.restoreAllMocks();
});

describe(
  'C-R196-02 / R89 keyboard focus is never hidden under the sticky timeline chrome',
  { timeout: 15_000 },
  () => {
    it('FR-a: the scroller scroll-padding-top follows the live chrome height on every resize', async () => {
      const { scroller, setChromeHeight } = await mountFocusRevealWorkspace();
      expect(resizeCallbacks.size).toBeGreaterThan(0);
      setChromeHeight(60);
      fireTimelineResize();
      expect(scroller.style.scrollPaddingTop).toBe('60px');
      setChromeHeight(84);
      fireTimelineResize();
      expect(scroller.style.scrollPaddingTop).toBe('84px');
      setChromeHeight(60);
      fireTimelineResize();
      expect(scroller.style.scrollPaddingTop).toBe('60px');
      expect(scroller.style.scrollPaddingLeft).toBe('');
    });

    it('FR-b: a zero-height chrome gives 0px, never NaNpx or an empty value', async () => {
      const { scroller, setChromeHeight } = await mountFocusRevealWorkspace();
      setChromeHeight(84);
      fireTimelineResize();
      expect(scroller.style.scrollPaddingTop).toBe('84px');
      setChromeHeight(0);
      fireTimelineResize();
      expect(scroller.style.scrollPaddingTop).toBe('0px');
      expect(scroller.style.scrollPaddingTop).not.toContain('NaN');
    });

    it('FR-c: writing the padding never scrolls the timeline by itself', async () => {
      const { scroller, setChromeHeight } = await mountFocusRevealWorkspace();
      const writes = trackScrollWrites(scroller);
      setChromeHeight(84);
      fireTimelineResize();
      setChromeHeight(108);
      fireTimelineResize();
      expect(scroller.style.scrollPaddingTop).toBe('108px');
      expect(writes).toStrictEqual({ scrollTop: [], scrollLeft: [], scrollCalls: 0 });
      expect(scroller.scrollTop).toBe(37);
      expect(scroller.scrollLeft).toBe(120);
    });
  },
);
