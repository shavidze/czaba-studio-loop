+
+function gestureRefusalPrefix(text: string): string | null {
+  for (const refusal of [GESTURE_EDIT_BLOCKED_MESSAGE, GESTURE_UNDO_BLOCKED_MESSAGE]) {
+    if (text === refusal || text.startsWith(`${refusal} `)) {
+      return refusal;
+    }
+  }
+  return null;
+}
+
+function statusAfterGestureRelease(current: string, lastNonRefusal: string): string {
+  const refusal = gestureRefusalPrefix(current);
+  if (refusal === null) {
+    return current;
+  }
+  const rest = current.slice(refusal.length).trimStart();
+  return [lastNonRefusal, rest].filter((part) => part.length > 0).join(' ');
+}
