+      expect(statusText(view)).toBe(`${DEMO_LOADING} ${tail}`);
+      let releaseGesture: () => void = () => {};
+      act(() => {
+        releaseGesture = live(api).beginPointerGesture();
+      });
+      act(() => live(api).setStatus(GESTURE_EDIT_BLOCKED_MESSAGE));
+      await settle();
+      act(() => releaseGesture());
+      expect(statusText(view)).toBe(`${DEMO_READY} ${tail}`);
