+        releaseGesture = live(api).beginPointerGesture();
+      });
+      act(() => live(api).setStatus(GESTURE_UNDO_BLOCKED_MESSAGE));
+      await act(async () => {
+        release();
+        for (let index = 0; index < 6; index += 1) {
