+function failingDeferredSeedCollection(): { collection: WorkspaceCollection; release: () => void } {
+  let release: () => void = () => {};
+  const gate = new Promise<void>((resolve) => {
+    release = resolve;
+  });
+  const collection: WorkspaceCollection = {
+    ...seedCollection,
+    id: 'seed-deferred-failing',
+    loadSource: async (source) => {
+      if (source.id !== 'stem-90') {
+        await gate;
+        throw new Error('fixture load failure');
+      }
+      return new AudioBuffer({ length: 400, numberOfChannels: 1, sampleRate: 100 });
+    },
+  };
+  return { collection, release: () => release() };
+}
+
+describe(
+  'SABA-B-11a-FIX-3 a gesture refusal shown when loading settles restores the settled text',
+  { timeout: 15_000 },
+  () => {
+    it('TU12 a refusal shown at settle is restored to the ready text on release, not loading', async () => {
+      const { api, view, settle } = await mountDeferredSeedWorkspace();
+      expect(statusText(view)).toBe(DEMO_LOADING);
+      let releaseGesture: () => void = () => {};
+      act(() => {
+        releaseGesture = live(api).beginPointerGesture();
+      });
+      act(() => live(api).setStatus(GESTURE_UNDO_BLOCKED_MESSAGE));
+      expect(statusText(view)).toBe(GESTURE_UNDO_BLOCKED_MESSAGE);
+      await settle();
+      expect(statusText(view)).toBe(GESTURE_UNDO_BLOCKED_MESSAGE);
+      act(() => releaseGesture());
+      expect(statusText(view)).toBe(DEMO_READY);
+    });
+
+    it('TU13 a refusal over a mount seed is restored to ready + seed on release', async () => {
+      const { api, view, settle } = await mountDeferredSeedWorkspace([
+        { id: 'c1', trackId: 'music', sourceId: 'stem-90', start: 2, sourceOffset: 0, duration: 4 },
+      ]);
