+function focusRowSuccessor(
+  container: HTMLElement | null,
+  removedId: string,
+  order: readonly string[],
+): void {
+  const index = order.indexOf(removedId);
+  const candidates = [...order.slice(index + 1), ...order.slice(0, Math.max(index, 0)).reverse()];
+  for (const rowId of candidates) {
+    const button = trackRowNameButton(container, rowId);
+    if (button) {
+      button.focus({ preventScroll: true });
+      return;
+    }
+  }
+}
