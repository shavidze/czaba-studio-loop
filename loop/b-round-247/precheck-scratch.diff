+
+function altDragClip(parts: { root: HTMLElement; header: HTMLElement }, dx: number) {
+  fireEvent.pointerDown(parts.header, {
+    ...press,
+    pointerId: 7,
+    clientX: 100,
+    clientY: MUSIC_LANE_Y,
+    altKey: true,
+  });
+  fireEvent.pointerMove(parts.root, {
+    pointerId: 7,
+    clientX: 100 + dx,
+    clientY: MUSIC_LANE_Y,
+    altKey: true,
+  });
+  fireEvent.pointerUp(parts.root, {
+    pointerId: 7,
+    clientX: 100 + dx,
+    clientY: MUSIC_LANE_Y,
+    altKey: true,
+  });
+}
+
+function pressArrowRight() {
+  fireEvent.keyDown(document.body, { key: 'ArrowRight', code: 'ArrowRight' });
+}
+
+describe(
+  'SABA-B-11b stage 2b Snap never lands on hidden grid lines (D-29z420)',
+  { timeout: 15_000 },
+  () => {
+    it('HS1 Snap on over hidden lines: paused title, data-snap-paused and one status note; zoom writes no status', async () => {
+      const { api, view } = await mountGridWorkspace();
+      const control = view.getByTestId('arrangement-grid-control');
+      fireEvent.change(divisionSelect(view), { target: { value: '0.1' } });
+      expect(view.getByTestId('arrangement-status').textContent).toBe('Grid: 0.1 s (Snap off)');
+      expect(control.dataset.snapPaused).toBe('false');
+      expect(snapToggle(view).title).toBe('Snap off — free movement (G)');
+      pressG();
+      expect(view.getByTestId('arrangement-status').textContent).toBe(SNAP_PAUSED_STATUS);
+      expect(snapToggle(view).title).toBe(SNAP_PAUSED_TITLE);
+      expect(snapToggle(view).getAttribute('aria-pressed')).toBe('true');
+      expect(control.dataset.snap).toBe('on');
+      expect(control.dataset.snapPaused).toBe('true');
+      act(() => live(api).setPxPerSecond(60));
+      expect(control.dataset.snapPaused).toBe('false');
+      expect(snapToggle(view).title).toBe('Snap on — clips land on the grid (G)');
+      expect(view.getByTestId('arrangement-status').textContent).toBe(SNAP_PAUSED_STATUS);
+      fireEvent.change(divisionSelect(view), { target: { value: '0.25' } });
+      expect(view.getByTestId('arrangement-status').textContent).toBe('Grid: 0.25 s (Snap on)');
+      act(() => live(api).setPxPerSecond(40));
+      fireEvent.change(divisionSelect(view), { target: { value: '0.1' } });
+      expect(view.getByTestId('arrangement-status').textContent).toBe(
+        'Grid: 0.1 s (Snap on) · Lines are hidden at this zoom, so Snap is paused — zoom in.',
+      );
+      pressG();
+      expect(view.getByTestId('arrangement-status').textContent).toBe(
