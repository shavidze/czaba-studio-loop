+import type { ArrangementClip } from '~/types/arrangement';
+
 export const GRID_DIVISIONS_SECONDS = [10, 5, 2, 1, 0.5, 0.25, 0.1] as const;
 
 export const GRID_DEFAULT_DIVISION_SECONDS = 1;
