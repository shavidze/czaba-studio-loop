function analyse(buf) {
  const tag = (o) => buf.toString('ascii', o, o + 4);
  if (tag(0) !== 'RIFF' || tag(8) !== 'WAVE') return { error: 'not RIFF/WAVE' };
  let o = 12; let fmt = null; let data = null;
  while (o + 8 <= buf.length) {
    const id = tag(o); const size = buf.readUInt32LE(o + 4);
    if (id === 'fmt ') fmt = { format: buf.readUInt16LE(o + 8), ch: buf.readUInt16LE(o + 10), sr: buf.readUInt32LE(o + 12), bits: buf.readUInt16LE(o + 22) };
    if (id === 'data') { data = { off: o + 8, size: Math.min(size, buf.length - o - 8) }; break; }
    o += 8 + size + (size % 2);
  }
  const bps = fmt.bits / 8; const frames = Math.floor(data.size / (bps * fmt.ch));
  const sample = (i, c) => {
    const p = data.off + (i * fmt.ch + c) * bps;
    if (fmt.format === 3 && fmt.bits === 32) return buf.readFloatLE(p);
    if (fmt.bits === 16) return buf.readInt16LE(p) / 32768;
    if (fmt.bits === 24) { const v = buf.readUIntLE(p, 3); return (v & 0x800000 ? v - 0x1000000 : v) / 8388608; }
    if (fmt.bits === 32) return buf.readInt32LE(p) / 2147483648;
    return NaN;
  };
  let first = -1; let nan = 0; let full = 0; let sumsq = 0; let peak = 0;
  const thr = 1 / 32768 * 4;
  for (let i = 0; i < frames; i++) {
    for (let c = 0; c < fmt.ch; c++) {
      const v = sample(i, c);
      if (Number.isNaN(v)) { nan++; continue; }
      const a = Math.abs(v);
      if (a >= 0.99997) full++;
      if (a > peak) peak = a;
      sumsq += v * v;
      if (first < 0 && a > thr) first = i;
    }
  }
  return { fmt, frames, seconds: frames / fmt.sr, firstAboveThrFrame: first, firstAboveThrSec: first >= 0 ? first / fmt.sr : null, nan, full, peak: +peak.toFixed(5), rms: +Math.sqrt(sumsq / Math.max(1, frames * fmt.ch)).toFixed(6), thr };
}
