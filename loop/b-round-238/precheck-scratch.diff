diff --git a/app/lib/arrangement/grid-divisions.ts b/app/lib/arrangement/grid-divisions.ts
index 5d0e5b3..aeb2b9c 100644
--- a/app/lib/arrangement/grid-divisions.ts
+++ b/app/lib/arrangement/grid-divisions.ts
@@ -184,3 +184,47 @@ export function gridDivisionTitle(id: string, linesVisible: boolean): string {
     ? studioGridStrings.titleLinesVisible(label)
     : studioGridStrings.titleLinesHidden(label);
 }
+
+export type GridMode = 'adaptive' | 'fixed';
+
+export const GRID_ADAPTIVE_MIN_SPACING_PX = 24;
+
+export const GRID_ADAPTIVE_DENSITY_MIN = -2;
+
+export const GRID_ADAPTIVE_DENSITY_MAX = 2;
+
+export function gridDivisionSecondsOf(id: string, bpm: number | null): number {
+  if (isMusicalGridDivisionId(id)) {
+    return bpm === null ? Number.NaN : musicalGridDivisionSeconds(id, bpm);
+  }
+  return Number(id);
+}
+
+function adaptiveBaseIndex(
+  family: readonly string[],
+  bpm: number | null,
+  pxPerSecond: number,
+): number {
+  for (let index = family.length - 1; index >= 0; index--) {
+    const spacing = gridDivisionSecondsOf(family[index] ?? '', bpm) * pxPerSecond;
+    if (spacing >= GRID_ADAPTIVE_MIN_SPACING_PX - 1e-6) {
+      return index;
+    }
+  }
+  return 0;
+}
+
+export function adaptiveGridDivisionId(
+  familyMember: string,
+  bpm: number | null,
+  pxPerSecond: number,
+  density = 0,
+): string {
+  const family = gridDivisionFamilyIds(familyMember);
+  if (family.indexOf(familyMember) < 0 || !(pxPerSecond > 0)) {
+    return familyMember;
+  }
+  const base = adaptiveBaseIndex(family, bpm, pxPerSecond);
+  const index = Math.min(family.length - 1, Math.max(0, base - density));
+  return family[index] ?? familyMember;
+}
