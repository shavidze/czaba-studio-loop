+interface PageClock {
+  offsetMs: number;
+  rttMs: number;
+}
+
+async function probePageClock(page: Page): Promise<PageClock> {
+  let best: PageClock | null = null;
+  for (let probe = 0; probe < clockProbeCount; probe += 1) {
+    const sentAt = Date.now();
+    const pageNow = await page.evaluate(() => performance.now());
+    const receivedAt = Date.now();
+    const rttMs = receivedAt - sentAt;
+    if (best === null || rttMs < best.rttMs) {
+      best = { offsetMs: (sentAt + receivedAt) / 2 - pageNow, rttMs };
+    }
+  }
+  if (best === null) throw new Error('the page clock probe took no reading');
+  return best;
+}
+
+function heapSamplesInWindow(
+  samples: readonly HeapSample[],
+  offsetMs: number,
+  from: number,
+  to: number,
+): HeapSample[] {
+  return samples.filter((sample) => {
+    const midpoint = (sample.sentAt + sample.receivedAt) / 2 - offsetMs;
+    return midpoint >= from && midpoint <= to;
+  });
+}
