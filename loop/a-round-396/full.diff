+declare global {
+  interface Window {
+    __czabaPreviewMedia?: HTMLMediaElement[];
+    __czabaPreviewRestore?: () => void;
+  }
+}
+
+async function measurePreviewStream(
+  page: Page,
+  cdp: CDPSession,
+  pcmReadyBytes: number,
+  result: ResourcePassResult,
+): Promise<void> {
+  await page.evaluate(() => {
+    const elements: HTMLMediaElement[] = [];
+    window.__czabaPreviewMedia = elements;
+    const nativePlay = HTMLMediaElement.prototype.play;
+    window.__czabaPreviewRestore = () => {
+      HTMLMediaElement.prototype.play = nativePlay;
+      window.__czabaPreviewMedia = undefined;
+      window.__czabaPreviewRestore = undefined;
+    };
+    HTMLMediaElement.prototype.play = function (this: HTMLMediaElement): Promise<void> {
+      if (!elements.includes(this)) elements.push(this);
+      return nativePlay.call(this);
+    };
+  });
+  try {
+    await runPreviewStream(page, cdp, pcmReadyBytes, result);
+  } finally {
+    await page.evaluate(() => window.__czabaPreviewRestore?.());
+  }
+}
+
+async function runPreviewStream(
+  page: Page,
+  cdp: CDPSession,
+  pcmReadyBytes: number,
+  result: ResourcePassResult,
+): Promise<void> {
+  const toggle = page.getByTestId('arrangement-library-preview-toggle');
+  await toggle.click();
+  const playing = await page
+    .waitForFunction(
+      () =>
+        (window.__czabaPreviewMedia ?? []).some(
+          (element) => !element.paused && element.currentTime >= 1,
+        ),
+      null,
+      { timeout: previewStreamTimeoutMs },
+    )
+    .then(() => true)
+    .catch(() => false);
+  const streaming = await page.evaluate(
+    () =>
+      (window.__czabaPreviewMedia ?? []).filter(
+        (element) => !element.paused && element.currentTime >= 1,
+      ).length,
+  );
+  result.samples.set('res.harness.preview-stream-playing', { value: streaming });
+  if (!playing) {
+    result.problems.push(
+      `preview stream: no media element playing at >= 1 s within ${previewStreamTimeoutMs} ms`,
+    );
+  }
+  const reading = await readPcmLiveAfterGc(cdp, page);
+  const summary = summarizePcmLive(reading.entries);
+  result.samples.set('res.mem.pcm-live-preview-delta-mib', {
+    value: toMebibytes(summary.bytes - pcmReadyBytes),
+  });
+  result.samples.set('res.mem.pcm-live-preview-decode-count', {
+    value: reading.entries.filter(
+      (entry) => entry.origin === 'decode' && classifyPcmProbe(entry) === null,
+    ).length,
+  });
+  if ((await toggle.textContent())?.trim() === studioLibraryPanelStrings.previewStop) {
+    await toggle.click();
+  }
+  await expect(toggle).toHaveText(studioLibraryPanelStrings.previewPlay);
+  await page.waitForTimeout(settleMs);
+}
